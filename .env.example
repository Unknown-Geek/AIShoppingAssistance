# ChromaDB Cloud Credentials
CHROMA_API_KEY=your_chroma_api_key_here

# CLIP embedding server endpoints (Supports automatic primary -> backup failover)
# PRIMARY_DETECTION_URL: Set to your self-hosted VM URL (e.g. http://<vm-ip>:7860 or http://localhost:7860)
PRIMARY_DETECTION_URL=
# BACKUP_DETECTION_URL: Set to your Hugging Face Space URL (e.g. https://<your-hf-space>.hf.space)
BACKUP_DETECTION_URL=

# Hugging Face API token (for authenticated HF Hub access if needed)
HF_API_TOKEN=your_hf_api_token_here

# Supabase — inventory database
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
